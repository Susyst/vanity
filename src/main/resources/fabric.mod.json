{
	"schemaVersion": 1,
	"id": "vanity",
	"version": "${version}",
	"name": "Vanity",
	"description": "Client-side armor looks: wear diamond but show netherite (or any armor), per slot or as a whole set. Any other item or block can be worn too, fitted to the armor shape.",
	"authors": [
		"Susyst"
	],
	"contact": {
		"sources": "https://github.com/Susyst/vanity"
	},
	"license": "MIT",
	"icon": "assets/vanity/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.susyst.vanity.VanityClient"
		]
	},
	"mixins": [
		"vanity.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
